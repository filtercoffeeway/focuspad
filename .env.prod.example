# FocusPad Production Environment
# Copy this file to .env.prod and update with your actual production values
# These settings are optimized for production deployment with security and performance

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-super-secret-key-change-this-to-a-long-random-string
DEBUG=False

# Database Configuration (Use strong password)
DB_PASSWORD=your-strong-database-password-here
DATABASE_URL=postgresql://focuspad_user:your-strong-database-password-here@db:5432/focuspad

# Encryption (Required for data security - generate with: openssl rand -base64 32)
FOCUSPAD_MASTER_KEY=your-base64-encoded-master-key-here

# Google OAuth (Required - get from Google Cloud Console)
# Configure OAuth redirect to your production domain
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application URL (Production domain)
BASE_URL=https://thefocuspad.com

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=7200

# CORS Configuration (Restrict to your domain only)
CORS_ORIGINS=https://thefocuspad.com

# Production Features
LOG_LEVEL=INFO
TESTING=False

# Database Configuration (Production optimized)
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=15

# Search Configuration
SEARCH_RESULTS_LIMIT=30

# Cache Configuration (Redis)
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=redis

# Security (Production settings - high security)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# Performance (Production optimized)
WORKERS=2
TIMEOUT=30
RELOAD=False

# SSL Configuration (if using internal nginx)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# Monitoring and Logging
SENTRY_DSN=your-sentry-dsn-for-error-tracking
LOG_FILE=/app/logs/focuspad.log
ACCESS_LOG=/app/logs/access.log

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://redis:6379/1
RATELIMIT_PER_METHOD=True
RATELIMIT_HEADERS_ENABLED=True

# Session Configuration
SESSION_TYPE=redis
SESSION_REDIS=redis://redis:6379/2
SESSION_PERMANENT=False
SESSION_USE_SIGNER=True

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1 