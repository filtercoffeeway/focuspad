# t2.micro Optimized Environment Variables
# Copy this file to .env.production and fill in your actual values
# This configuration is specifically optimized for AWS t2.micro (1GB RAM)

# Flask Configuration (Optimized for t2.micro)
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-here-make-it-very-long-and-random
DEBUG=False

# Database Configuration (Strong password required)
DB_PASSWORD=your-strong-database-password-here
DATABASE_URL=postgresql://focuspad_user:your-strong-database-password-here@db:5432/focuspad

# Encryption (Required for data security)
FOCUSPAD_MASTER_KEY=your-base64-encoded-master-key-here

# Google OAuth (Required - get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API (Optional - for AI features, may be slow on t2.micro)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application URL (Update with your EC2 public IP or domain)
BASE_URL=http://your-ec2-ip-or-domain

# JWT Configuration (Optimized for t2.micro)
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=7200

# Security Headers (HTTP for t2.micro, upgrade to HTTPS later)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# t2.micro Performance Optimizations
# These settings help reduce memory usage and improve performance
FLASK_SKIP_DOTENV=1
WERKZEUG_RUN_MAIN=true

# Logging Level (WARNING to reduce disk I/O on t2.micro)
LOG_LEVEL=WARNING

# Database Connection Pool (Reduced for t2.micro)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Search Configuration (Reduced limits for t2.micro)
SEARCH_RESULTS_LIMIT=20
SEARCH_TIMEOUT=30

# Notes:
# - Generate strong random keys using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# - Generate master key using: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# - Monitor CPU burst credits in AWS CloudWatch
# - Consider upgrading to t3.small for production workloads
# - Enable swap file during deployment (deploy-micro.sh handles this) 