# Production Environment Variables for AWS EC2 Deployment
# Copy this file to .env.production and fill in your actual values

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-here-make-it-very-long-and-random
DEBUG=False

# Database Configuration
DB_PASSWORD=your-strong-database-password-here
DATABASE_URL=postgresql://focuspad_user:your-strong-database-password-here@db:5432/focuspad

# Encryption
FOCUSPAD_MASTER_KEY=your-base64-encoded-master-key-here

# Google OAuth (Required)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application URL (Update with your EC2 public IP or domain)
BASE_URL=http://your-ec2-ip-or-domain

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# Security Headers
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax 