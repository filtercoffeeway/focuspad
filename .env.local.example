# FocusPad Local Development Environment
# Copy this file to .env.local for local development
# These settings are optimized for development with debug features enabled

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# Database Configuration (Development defaults)
DB_PASSWORD=focuspad_dev_password
DATABASE_URL=postgresql://focuspad_user:focuspad_dev_password@db:5432/focuspad

# Encryption (Use development key for local testing)
FOCUSPAD_MASTER_KEY=ZGV2LW1hc3Rlci1rZXktZm9yLWxvY2FsLWRldmVsb3BtZW50LW9ubHk=

# Google OAuth (Required - get from Google Cloud Console)
# For local development, configure OAuth redirect to http://localhost:5000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application URL (Local development)
BASE_URL=http://localhost:5000

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS Configuration (Allow multiple development ports)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# Development Features
LOG_LEVEL=DEBUG
TESTING=False

# Database Configuration
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Search Configuration
SEARCH_RESULTS_LIMIT=50

# Cache Configuration (Redis)
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=redis

# Security (Development settings - less secure for convenience)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Performance (Development optimized)
WORKERS=1
TIMEOUT=60
RELOAD=True 